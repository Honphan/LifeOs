# Frontend API configuration
# Copy this file to .env.local and update the values to match your backend.

# Base URL of your backend API
VITE_API_BASE_URL=http://localhost:8080/api

# Auth endpoints used by the frontend
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REGISTER_PATH=/auth/register
# Spring OAuth2 — startGoogleLogin() dùng VITE_BACKEND_URL hoặc origin của VITE_API_BASE_URL
VITE_BACKEND_URL=http://localhost:8080
VITE_AUTH_ME_PATH=/auth/me

# Optional frontend URL used by OAuth redirect flows
VITE_APP_URL=http://localhost:5173

# Optional redirect URI passed to the backend Google auth endpoint
# VITE_AUTH_GOOGLE_REDIRECT_URI=http://localhost:5173

# Optional backend logout endpoint (POST)
# VITE_AUTH_LOGOUT_PATH=/auth/logout